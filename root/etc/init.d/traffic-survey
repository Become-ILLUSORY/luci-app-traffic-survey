#!/bin/sh /etc/rc.common
# traffic-survey: enable conntrack accounting (+ MTK HNAT counter feedback)
# and run the luci.client-rates ubus daemon.
#
# Copyright (C) 2026  GPL-2.0-only

START=70
STOP=10
USE_PROCD=1

apply_sysctls() {
	# Per-flow byte accounting (bytes= counters in conntrack)
	[ -w /proc/sys/net/netfilter/nf_conntrack_acct ] && \
		echo 1 > /proc/sys/net/netfilter/nf_conntrack_acct

	# MediaTek HNAT: merge PPE per-entry counters back into conntrack so
	# hardware-offloaded flows are still accounted. No-op without mtkhnat.
	if [ -w /sys/kernel/debug/hnat/hnat_setting ]; then
		echo 7 1 > /sys/kernel/debug/hnat/hnat_setting 2>/dev/null
		logger -t traffic-survey "enabled HNAT counter feedback to conntrack"
	fi
}

start_service() {
	apply_sysctls

	procd_open_instance client-rates
	procd_set_param command /usr/libexec/rpcd/luci.client-rates
	procd_set_param respawn 3600 2 0
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger network
}
