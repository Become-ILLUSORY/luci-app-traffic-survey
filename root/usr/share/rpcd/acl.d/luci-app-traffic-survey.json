{
	"luci-app-traffic-survey": {
		"description": "Read access to per-host traffic survey",
		"read": {
			"ubus": {
				"luci.client-rates": [ "get" ],
				"traffic-survey-meta": [ "get" ],
				"luci-rpc": [ "getDHCPLeases" ],
				"network.rrdns": [ "lookup" ]
			},
			"file": {
				"/proc/net/arp": [ "read" ],
				"/proc/net/nf_conntrack": [ "read" ],
				"/proc/sys/net/netfilter/nf_conntrack_acct": [ "read" ],
				"/tmp/dhcp.leases": [ "read" ],
				"/tmp/luci-client-rates/*": [ "read" ],
				"/tmp/traffic-survey-vendor/*": [ "read" ]
			}
		}
	}
}
